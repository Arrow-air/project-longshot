{
    "Exclude": [
        "^engineering/electronics/pcbs/.*/kicad/.*\\.kicad_(pcb|prl|pro|sch|sym)$",
        "^engineering/electronics/pcbs/.*/kicad/libs/.*\\.(kicad_mod|stp|step)$",
        "^engineering/electronics/pcbs/.*/kicad/.*-backups/.*\\.zip$",
        "^engineering/electronics/pcbs/.*/kicad/.*\\.lck$",
        "^engineering/cad/build123d/exports/.*\\.(step|stl)$",
